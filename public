<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<title>Alya Arama Paneli</title>
<style>
    body {
        background: #0d1117;
        color: #e6edf3;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }
    .panel {
        background: #161b22;
        padding: 30px;
        border-radius: 12px;
        width: 350px;
        box-shadow: 0px 0px 20px #000;
        text-align: center;
    }
    input {
        width: 100%;
        padding: 12px;
        margin-top: 10px;
        border-radius: 8px;
        border: none;
        outline: none;
        font-size: 16px;
        background: #0d1117;
        color: #fff;
        border: 1px solid #30363d;
    }
    button {
        margin-top: 15px;
        width: 100%;
        padding: 12px;
        background: #238636;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 18px;
        cursor: pointer;
        transition: 0.3s;
    }
    button:hover {
        background: #2ea043;
    }
    #result {
        margin-top: 20px;
        font-size: 15px;
        white-space: pre-line;
    }
</style>
</head>
<body>

<div class="panel">
    <h2>📞 Alya Arama Paneli</h2>
    <p>Müşteri numarasını gir ve aramayı başlat.</p>

    <input type="text" id="phone" placeholder="+90XXXXXXXXXX">
    <button onclick="callCustomer()">Alya Arasın</button>

    <div id="result"></div>
</div>

<script>
async function callCustomer() {
    const phone = document.getElementById("phone").value;
    const resultDiv = document.getElementById("result");

    if (!phone.startsWith("+")) {
        resultDiv.innerText = "❌ Lütfen + ile başlayan geçerli bir numara girin.";
        return;
    }

    resultDiv.innerText = "⏳ Arama başlatılıyor...";

    try {
        const response = await fetch("https://alya-call-system.onrender.com/call-customer", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ phone })
        });

        const data = await response.json();

        if (data.ok) {
            resultDiv.innerText = `✅ Arama başlatıldı!\nCall SID:\n${data.callSid}`;
        } else {
            resultDiv.innerText = `❌ Hata: ${JSON.stringify(data)}`;
        }

    } catch (err) {
        resultDiv.innerText = "❌ Sunucuya ulaşılamadı.\n" + err;
    }
}
</script>

</body>
</html>
